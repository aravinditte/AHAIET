# Copy to .env / set in PowerShell. All optional; defaults are in backend/app/core/config.py
AHAIET_UPLOAD_MAX_BYTES=10485760
AHAIET_UPLOAD_MAX_PIXELS=40000000
AHAIET_STORAGE_DIR=
AHAIET_DB_PATH=
AHAIET_RETENTION_DAYS=30
AHAIET_TESSERACT_CMD=tesseract
AHAIET_TESSERACT_LANG=heb
NEXT_PUBLIC_API_BASE=http://127.0.0.1:8000
AHAIET_TESSDATA_PREFIX=
TESSDATA_PREFIX=
AHAIET_OCR_CONF_THRESHOLD=60
AHAIET_OCR_PSM=6
AHAIET_CORPUS_DIR=
# Trained translation models (local binaries; runtime never needs WSL2)
AHAIET_MOSES_CMD=moses
AHAIET_MARIAN_DECODER_CMD=marian-decoder
AHAIET_TRANSLATION_TIMEOUT_S=120
# Complete passages: per-request segment/length limits for multiline input
AHAIET_MAX_SEGMENTS=64
AHAIET_MAX_PASSAGE_CHARS=20000
# Trained-model translation result cache (SQLite). 0 disables it.
# Verified corpus retrieval is never served from this cache.
AHAIET_TRANSLATION_CACHE=1
# Kraken historical recognition (optional; ketos CLI name/path)
AHAIET_KRAKEN_CMD=ketos
# Security and release hardening (docs/SECURITY.md)
# CORS: comma-separated allowed frontend origins; never a wildcard by default
AHAIET_CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# App-level request body ceiling in bytes; 0 = upload limit + 1 MiB
AHAIET_REQUEST_MAX_BYTES=0
# Per-client fixed-window rate limits (requests per minute)
AHAIET_RATE_LIMIT_UPLOADS_PER_MIN=30
AHAIET_RATE_LIMIT_OCR_PER_MIN=30
AHAIET_RATE_LIMIT_TRANSLATE_PER_MIN=60
AHAIET_RATE_LIMIT_PROCESS_PER_MIN=30
# History recording: 0/false disables writes and reports a disabled state
AHAIET_HISTORY_ENABLED=1
# Retention maintenance (python -m app.maintenance); optional startup sweep
AHAIET_RETENTION_SWEEP_ON_STARTUP=0
# Best-effort zero-overwrite before unlink during retention (not a forensic guarantee)
AHAIET_SECURE_DELETE_OVERWRITE=0
# Remediation settings (see docs/SECURITY.md / docs/API.md)
AHAIET_PERSIST_RESULTS=1
AHAIET_JOB_WORKERS=2
AHAIET_JOB_RESULT_TTL_S=3600
AHAIET_JOB_DEADLINE_S=600
AHAIET_MAX_CONCURRENT_OCR=2
AHAIET_MAX_CONCURRENT_TRANSLATION=2
AHAIET_PREPROCESSING_MAX_BYTES=536870912
AHAIET_SCRIPT_MIN_TEST_SAMPLES=20
AHAIET_RATE_LIMIT_MAX_CLIENTS=10000
AHAIET_TRUST_FORWARDED_FOR=0
# AHAIET_ACCESS_TOKEN is unset by default (local mode); when set, upload reads and history require the X-AHAIET-Access-Token header
AHAIET_OCR_TIMEOUT_S=120
